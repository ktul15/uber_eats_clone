# Uber Eats Clone - Backend Environment Variables

PORT=8000
DATABASE_URL="postgresql://user:password@localhost:5432/uber_eats_db?schema=public"

# ==========================================
# Firebase Admin SDK (For Auth/FCM)
# ==========================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Note: Ensure the private key retains its formatting (e.g. \n characters)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ==========================================
# Stripe (For Payments)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
