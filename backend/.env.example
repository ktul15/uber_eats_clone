# Uber Eats Clone - Backend Environment Variables

PORT=8000
DATABASE_URL="postgresql://user:password@localhost:5432/uber_eats_db?schema=public"
# Railway staging uses a sealed service-local DATABASE_URL; follow RAILWAY_STAGING.md for synchronized rotation.
BASE_URL="http://localhost:8000"
APP_ENV="development"
JWT_SECRET="replace-with-a-long-random-secret"
ALLOWED_ORIGINS="http://localhost:3000"
UPLOAD_DIR="./uploads"
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000

# ==========================================
# Firebase Admin SDK (For Auth/FCM)
# ==========================================
FIREBASE_PROJECT_ID="your-firebase-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
# Note: Ensure the private key retains its formatting (e.g. \n characters)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ==========================================
# Stripe (For Payments)
# ==========================================
STRIPE_SECRET_KEY="sk_test_..."
